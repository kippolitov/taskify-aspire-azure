<?xml version="1.0" encoding="utf-8" ?>
<!--
  Coverage collection for both test projects. The 80% overall and 95% critical-path
  line-coverage gates are enforced in .github/workflows/ci.yml through ReportGenerator.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <!-- Exclude generated code and non-testable entry points -->
          <Exclude>
            [Taskify.AppHost]*
            [Taskify.Benchmarks]*
            [Taskify.ServiceDefaults]*
            [*]*.Migrations.*
            [*]*Program
            [*]Microsoft.Extensions.Validation.Generated.*
            [*]Microsoft.AspNetCore.OpenApi.Generated.*
            [*]System.Runtime.CompilerServices.*
          </Exclude>
          <!-- Source-generator output (validation, OpenAPI) is not our code -->
          <ExcludeByAttribute>GeneratedCodeAttribute</ExcludeByAttribute>
          <!-- Include source projects -->
          <Include>
            [Taskify.Api]*
            [Taskify.Web]*
            [Taskify.Shared]*
          </Include>
          <ExcludeByFile>
            **/obj/**
            **/Migrations/**
          </ExcludeByFile>
          <Format>opencover</Format>
          <UseSourceLink>true</UseSourceLink>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
