<Project Sdk="Aspire.AppHost.Sdk/13.1.2">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>85ba9a23-73bb-4d99-bbc8-c0263fb6623c</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.Azure.PostgreSQL" />
    <!-- Pin transitive MessagePack to a patched version (GHSA-hv8m-jj95-wg3x; vulnerable <= 2.5.192) -->
    <PackageReference Include="MessagePack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Taskify.Migrator\Taskify.Migrator.csproj" />
    <ProjectReference Include="..\Taskify.Api\Taskify.Api.csproj" />
    <ProjectReference Include="..\Taskify.Web\Taskify.Web.csproj" />
  </ItemGroup>

</Project>
