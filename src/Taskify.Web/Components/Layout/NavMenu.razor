<div class="nav-shell">
    <div class="nav-header">
        <div class="brand-wrap">
            <a class="navbar-brand" href="">Taskify</a>
            <span class="brand-subtitle">Project collaboration</span>
        </div>

        <button
            type="button"
            title="Navigation menu"
            aria-label="Toggle navigation"
            aria-expanded="@_isMenuOpen"
            class="navbar-toggler @(_isMenuOpen ? "is-open" : string.Empty)"
            @onclick="ToggleMenu"></button>
    </div>

    <div class="nav-scrollable @(_isMenuOpen ? "is-open" : string.Empty)">
        <nav class="nav-menu-links">
            <div class="nav-item">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All" @onclick="CloseMenu">
                    <span class="nav-link__text">Home</span>
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="projects" @onclick="CloseMenu">
                    <span class="nav-link__text">Projects</span>
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="projects" Match="NavLinkMatch.Prefix" @onclick="CloseMenu">
                    <span class="nav-link__text">Boards</span>
                </NavLink>
            </div>

            <div class="nav-footer">
                <span>Taskify</span>
                <small>Built with Blazor</small>
            </div>
        </nav>
    </div>
</div>

@code {
    private bool _isMenuOpen;

    private void ToggleMenu() => _isMenuOpen = !_isMenuOpen;

    private void CloseMenu() => _isMenuOpen = false;
}

