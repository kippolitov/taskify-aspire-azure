      "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', format('ca-taskify-api-{0}-{1}', parameters('environmentName'), parameters('uniqueId'))), '2024-03-01').configuration.ingress.fqdn)]"
    },
    "taskifyWebFqdn": {
      "type": "string",
