    }
  },
  "parameters": {
    "environmentName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "metadata": {
        "description": "Environment name (dev, prod)"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for all resources"
      }
    },
    "uniqueId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 8,
      "metadata": {
        "description": "Unique identifier suffix to prevent naming conflicts"
      }
    },
    "logAnalyticsWorkspaceId": {
      "type": "string",
      "metadata": {
        "description": "Log Analytics Workspace resource ID"
      }
    },
    "logAnalyticsWorkspaceCustomerId": {
      "type": "string",
      "metadata": {
        "description": "Log Analytics Workspace customer ID"
      }
    },
    "applicationInsightsConnectionString": {
      "type": "securestring",
      "metadata": {
        "description": "Application Insights connection string"
      }
    },
    "taskifyApiImage": {
      "type": "string",
      "metadata": {
        "description": "Container image for Taskify.Api"
      }
    },
    "taskifyWebImage": {
      "type": "string",
      "metadata": {
        "description": "Container image for Taskify.Web"
      }
    },
    "cpu": {
      "type": "string",
      "defaultValue": "0.25",
      "metadata": {
        "description": "Container App CPU allocation (0.25, 0.5, 1.0, 2.0, 4.0)"
      }
    },
    "memory": {
      "type": "string",
      "defaultValue": "0.5Gi",
      "metadata": {
        "description": "Container App memory allocation (0.5Gi, 1Gi, 2Gi, 4Gi, 8Gi)"
      }
    },
    "minReplicas": {
      "type": "int",
      "defaultValue": 0,
      "minValue": 0,
      "maxValue": 30,
      "metadata": {
        "description": "Minimum replicas for Container Apps (0 = scale to zero)"
      }
    },
    "maxReplicas": {
      "type": "int",
      "defaultValue": 10,
      "minValue": 1,
      "maxValue": 30,
      "metadata": {
        "description": "Maximum replicas for Container Apps"
      }
    },
    "postgresqlConnectionString": {
      "type": "securestring",
      "metadata": {
        "description": "PostgreSQL connection string"
      }
    },
    "containerRegistryLoginServer": {
      "type": "string",
      "metadata": {
        "description": "Azure Container Registry login server"
      }
    },
    "containerRegistryUsername": {
      "type": "securestring",
      "metadata": {
        "description": "Azure Container Registry admin username"
      }
    },
    "containerRegistryPassword": {
      "type": "securestring",
      "metadata": {
        "description": "Azure Container Registry admin password"
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2024-03-01",
      "name": "[format('cae-taskify-{0}-{1}', parameters('environmentName'), parameters('uniqueId'))]",
      "location": "[parameters('location')]",
      "properties": {
        "appLogsConfiguration": {
          "destination": "log-analytics",
          "logAnalyticsConfiguration": {
            "customerId": "[parameters('logAnalyticsWorkspaceCustomerId')]",
            "sharedKey": "[listKeys(parameters('logAnalyticsWorkspaceId'), '2023-09-01').primarySharedKey]"
          }
        },
        "zoneRedundant": "[if(equals(parameters('environmentName'), 'prod'), true(), false())]"
      }
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[format('ca-taskify-api-{0}-{1}', parameters('environmentName'), parameters('uniqueId'))]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "tags": {
        "azd-service-name": "api"
      },
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', format('cae-taskify-{0}-{1}', parameters('environmentName'), parameters('uniqueId')))]",
        "configuration": {
          "ingress": {
            "external": true,
            "targetPort": 8080,
            "transport": "auto",
            "allowInsecure": false
          },
          "registries": [
            {
              "server": "[parameters('containerRegistryLoginServer')]",
              "username": "[parameters('containerRegistryUsername')]",
              "passwordSecretRef": "acr-password"
            }
          ],
          "secrets": [
            {
              "name": "acr-password",
              "value": "[parameters('containerRegistryPassword')]"
            },
            {
              "name": "postgresql-connection-string",
              "value": "[parameters('postgresqlConnectionString')]"
            },
            {
              "name": "applicationinsights-connection-string",
              "value": "[parameters('applicationInsightsConnectionString')]"
            }
          ]
        },
        "template": {
          "containers": [
            {
              "name": "taskify-api",
              "image": "[parameters('taskifyApiImage')]",
              "resources": {
                "cpu": "[json(parameters('cpu'))]",
                "memory": "[parameters('memory')]"
              },
              "env": [
                {
                  "name": "ASPNETCORE_ENVIRONMENT",
                  "value": "[if(equals(parameters('environmentName'), 'prod'), 'Production', 'Development')]"
                },
                {
                  "name": "ASPNETCORE_URLS",
                  "value": "http://+:8080"
                },
                {
                  "name": "ConnectionStrings__DefaultConnection",
                  "secretRef": "postgresql-connection-string"
                },
                {
                  "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
                  "secretRef": "applicationinsights-connection-string"
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": "[parameters('minReplicas')]",
            "maxReplicas": "[parameters('maxReplicas')]",
            "rules": [
              {
                "name": "http-rule",
                "http": {
                  "metadata": {
                    "concurrentRequests": "100"
                  }
                }
              }
            ]
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', format('cae-taskify-{0}-{1}', parameters('environmentName'), parameters('uniqueId')))]"
      ]
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[format('ca-taskify-web-{0}-{1}', parameters('environmentName'), parameters('uniqueId'))]",
      "location": "[parameters('location')]",
      "tags": {
        "azd-service-name": "web"
      },
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', format('cae-taskify-{0}-{1}', parameters('environmentName'), parameters('uniqueId')))]",
        "configuration": {
          "ingress": {
            "external": true,
            "targetPort": 8080,
            "transport": "auto",
            "allowInsecure": false
          },
          "registries": [
            {
              "server": "[parameters('containerRegistryLoginServer')]",
              "username": "[parameters('containerRegistryUsername')]",
              "passwordSecretRef": "acr-password"
            }
          ],
          "secrets": [
            {
              "name": "acr-password",
              "value": "[parameters('containerRegistryPassword')]"
            },
            {
              "name": "applicationinsights-connection-string",
              "value": "[parameters('applicationInsightsConnectionString')]"
            }
          ]
        },
        "template": {
          "containers": [
            {
              "name": "taskify-web",
              "image": "[parameters('taskifyWebImage')]",
              "resources": {
                "cpu": "[json(parameters('cpu'))]",
                "memory": "[parameters('memory')]"
              },
              "env": [
                {
                  "name": "ASPNETCORE_ENVIRONMENT",
                  "value": "[if(equals(parameters('environmentName'), 'prod'), 'Production', 'Development')]"
                },
                {
                  "name": "ASPNETCORE_URLS",
                  "value": "http://+:8080"
                },
                {
                  "name": "services__api__http__0",
                  "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', format('ca-taskify-api-{0}-{1}', parameters('environmentName'), parameters('uniqueId'))), '2024-03-01').configuration.ingress.fqdn)]"
                },
                {
                  "name": "services__api__https__0",
                  "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', format('ca-taskify-api-{0}-{1}', parameters('environmentName'), parameters('uniqueId'))), '2024-03-01').configuration.ingress.fqdn)]"
                },
                {
                  "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
                  "secretRef": "applicationinsights-connection-string"
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": "[parameters('minReplicas')]",
            "maxReplicas": "[parameters('maxReplicas')]",
            "rules": [
              {
                "name": "http-rule",
                "http": {
                  "metadata": {
                    "concurrentRequests": "100"
                  }
                }
              }
            ]
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', format('cae-taskify-{0}-{1}', parameters('environmentName'), parameters('uniqueId')))]",
        "[resourceId('Microsoft.App/containerApps', format('ca-taskify-api-{0}-{1}', parameters('environmentName'), parameters('uniqueId')))]"
      ]
    }
  ],
  "outputs": {
    "containerAppsEnvironmentId": {
      "type": "string",
      "metadata": {
        "description": "Container Apps Environment resource ID"
      },
      "value": "[resourceId('Microsoft.App/managedEnvironments', format('cae-taskify-{0}-{1}', parameters('environmentName'), parameters('uniqueId')))]"
    },
    "containerAppsEnvironmentName": {
